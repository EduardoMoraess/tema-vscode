{
    // ─────────────────────────────────────────────
    // WORKBENCH
    // ─────────────────────────────────────────────
    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",
    "workbench.statusBar.visible": true,
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.productIconTheme": "fluent-icons",
    // ─────────────────────────────────────────────
    // MIDNIGHT PROFESSIONAL - PYTHON
    // ─────────────────────────────────────────────
    "workbench.colorCustomizations": {
        "editor.background": "#111827",
        "editor.foreground": "#D6DEE9",
        "editorLineNumber.foreground": "#526078",
        "editorLineNumber.activeForeground": "#82AAFF",
        "editorCursor.foreground": "#82AAFF",
        "editor.selectionBackground": "#34445D80",
        "editor.lineHighlightBackground": "#192438",
        "editorIndentGuide.background1": "#263449",
        "editorIndentGuide.activeBackground1": "#526B91",
        "sideBar.background": "#151E2D",
        "sideBar.foreground": "#C5D0E0",
        "sideBar.border": "#263449",
        "activityBar.background": "#151E2D",
        "activityBar.foreground": "#82AAFF",
        "activityBar.inactiveForeground": "#718096",
        "panel.background": "#151E2D",
        "panel.border": "#263449",
        "tab.activeBackground": "#111827",
        "tab.inactiveBackground": "#192438",
        "tab.activeForeground": "#E6EDF7",
        "tab.inactiveForeground": "#8492A6",
        "tab.border": "#263449",
        "statusBar.background": "#1C3044",
        "statusBar.foreground": "#C9D9EA",
        "statusBar.noFolderBackground": "#1C3044",
        "statusBar.debuggingBackground": "#285B50",
        "statusBar.debuggingForeground": "#FFFFFF",
        "titleBar.activeBackground": "#151E2D",
        "titleBar.activeForeground": "#D6DEE9",
        "focusBorder": "#82AAFF",
        "widget.border": "#34445D",
        "input.background": "#1B2739",
        "input.foreground": "#E6EDF7",
        "input.border": "#34445D",
        "list.activeSelectionBackground": "#263B57",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#202E42",
        "terminal.background": "#111827",
        "terminal.foreground": "#D6DEE9"
    },
    // ─────────────────────────────────────────────
    // EXPLORER
    // ─────────────────────────────────────────────
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "workbench.tree.indent": 14,
    // ─────────────────────────────────────────────
    // EDITOR
    // ─────────────────────────────────────────────
    "editor.fontFamily": "JetBrains Mono, Medium",
    "editor.fontSize": 10.7,
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.55,
    "editor.wordWrap": "on",
    "editor.renderLineHighlight": "gutter",
    "editor.renderWhitespace": "selection",
    "editor.semanticHighlighting.enabled": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.scrollBeyondLastLine": false,
    "editor.minimap.enabled": true,
    "editor.stickyScroll.enabled": true,
    // ─────────────────────────────────────────────
    // INDENTAÇÃO
    // ─────────────────────────────────────────────
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": "always",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    // ─────────────────────────────────────────────
    // INTELLISENSE
    // ─────────────────────────────────────────────
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "editor.suggestSelection": "first",
    "editor.suggest.localityBonus": true,
    "editor.parameterHints.enabled": true,
    "editor.hover.delay": 250,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.inlineSuggest.enabled": true,
    "editor.snippetSuggestions": "top",
    // ─────────────────────────────────────────────
    // PRODUTIVIDADE
    // ─────────────────────────────────────────────
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.formatOnSave": true,
    // ─────────────────────────────────────────────
    // PESQUISA
    // ─────────────────────────────────────────────
    "search.smartCase": true,
    "search.useIgnoreFiles": true,
    "search.exclude": {
        "**/.git": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true
    },
    // ─────────────────────────────────────────────
    // ARQUIVOS
    // ─────────────────────────────────────────────
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    // ─────────────────────────────────────────────
    // GIT
    // ─────────────────────────────────────────────
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "never",
    "git.decorations.enabled": true,
    // ─────────────────────────────────────────────
    // TERMINAL
    // ─────────────────────────────────────────────
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
    "terminal.integrated.fontSize": 11,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.scrollback": 5000,
    // ─────────────────────────────────────────────
    // PYTHON
    // ─────────────────────────────────────────────
    "python.createEnvironment.trigger": "off",
    "python.analysis.completeFunctionParens": true,
    "python.analysis.inlayHints.functionReturnTypes": false,
    "python.analysis.inlayHints.variableTypes": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    // ─────────────────────────────────────────────
    // LIVE SERVER
    // ─────────────────────────────────────────────
    "liveServer.settings.donotShowInfoMsg": true,
    // ─────────────────────────────────────────────
    // SINTAXE PYTHON
    // ─────────────────────────────────────────────
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "variable",
                    "variable.other.readwrite",
                    "variable.other.local",
                    "variable.other.object"
                ],
                "settings": {
                    "foreground": "#D6DEE9"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function"
                ],
                "settings": {
                    "foreground": "#82AAFF"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#C792EA"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#C792EA"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted"
                ],
                "settings": {
                    "foreground": "#A6D189"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#E5B567"
                }
            },
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#8291A8",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "entity.name.function.decorator",
                    "punctuation.definition.decorator"
                ],
                "settings": {
                    "foreground": "#E5B567"
                }
            },
            {
                "scope": [
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#E58C8C"
                }
            },
            {
                "scope": [
                    "constant.language"
                ],
                "settings": {
                    "foreground": "#E5B567"
                }
            },
            {
                "scope": [
                    "keyword.operator"
                ],
                "settings": {
                    "foreground": "#72C7D9"
                }
            }
        ]
    },
    // ─────────────────────────────────────────────
    // TEMA
    // ─────────────────────────────────────────────
    "workbench.iconTheme": "catppuccin-perfect-dark",
    "workbench.colorTheme": "Default High Contrast"
}